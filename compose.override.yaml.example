services:
  # # Disable Ollama when running it on the host, e.g., for direct
  # # access to the GPU on macOS.
  # ollama:
  #   profiles:
  #     - disabled

  pgvector:
    environment:
      LITELLM_PASSWORD: sMk81xKccqqR
      OPENWEBUI_PASSWORD: Q1KSktvC4X5u
      POSTGRES_PASSWORD: xFOJpseTQnQYN

  litellm:
    configs:
      - source: litellm
        target: /etc/litellm/litellm-config.yaml
        uid: "0"
        gid: "0"
        mode: 0o444
    command: --config /etc/litellm/litellm-config.yaml
    environment:
      DATABASE_URL: postgresql://litellm:sMk81xKccqqR@pgvector:5432/litellm
      GOOGLE_API_KEY: AIzaSyD9gG1lj6VdxYZmOwXc3fD4A5yDk9wSDF
      LITELLM_MASTER_KEY: &litellm-master-key My5IvBvZ7C6hDGhCV8HNmL
    # # Connect to Ollama running on the host via this hostname
    # # (requires Docker 20.10 or newer).
    # extra_hosts:
    #   - "host.docker.internal:host-gateway"

  redis:
    command: --requirepass 2dG8qao88qo1M9wyNL

  openwebui:
    environment:
      DATABASE_URL: postgresql://openwebui:Q1KSktvC4X5u@pgvector:5432/openwebui
      OPENAI_API_KEY: *litellm-master-key
      RAG_OPENAI_API_KEY: *litellm-master-key
      REDIS_URL: redis://:2dG8qao88qo1M9wyNL@redis:6379/0
      WEBUI_SECRET_KEY: NVNIaFDZFhJ9fCWPIXzt

  openclaw:
    configs:
      - source: openclaw
        target: /home/node/.openclaw/openclaw.json
        uid: "0"
        gid: "0"
        mode: 0o444

configs:
  litellm:
    content: |
      model_list:
        - model_name: bge-m3:567m
          litellm_params: &ollama
            model: ollama/bge-m3:567m
            api_base: http://ollama:11434  # or http://host.docker.internal:11434
            input_cost_per_token: 0
            output_cost_per_token: 0
        - model_name: llama3.2:1b
          litellm_params:
            <<: *ollama
            model: ollama/llama3.2:1b
            temperature: 0.2
        - model_name: qwen2.5-coder
          litellm_params:
            <<: *ollama
            model: ollama/qwen2.5-coder:latest
        - model_name: gemini-2.5-pro
          litellm_params: &google
            model: gemini/gemini-2.5-pro
            api_key: os.environ/GOOGLE_API_KEY
            input_cost_per_token: 0.00000125
            output_cost_per_token: 0.00001
        - model_name: gemini-2.5-flash
          litellm_params:
            <<: *google
            model: gemini/gemini-2.5-flash
            input_cost_per_token: 0.0000003
            output_cost_per_token: 0.0000025
      general_settings:
        enforce_user_param: False

  # Test this configuration with
  # `docker compose run -it --rm openclaw`.
  openclaw:
    content: |
      {
        "plugins": {
          "entries": {
            "litellm": {
              "enabled": true
            }
          }
        },
        "models": {
          "providers": {
            "litellm": {
              "baseUrl": "http://litellm:4000",
              "apiKey": "My5IvBvZ7C6hDGhCV8HNmL",
              "api": "openai-completions",
              "models": [
                {
                  "id": "qwen3:14b",
                  "name": "Qwen3-14B-Q4_K_M",
                  "reasoning": true,
                  "input": ["text", "image"],
                  contextWindow: 10000,
                  maxTokens: 10000,
                }
              ]
            }
          }
        },
        "agents": {
          "defaults": {
            "model": {
              "primary": "litellm/qwen3:14b"
            },
          "workspace": "/home/node/.openclaw/workspace"
          }
        },
        "gateway": {
          "mode": "local",
          "auth": {
            "mode": "token",
            "token": "94454a10a859b5ef1166a83471afdc7ba93ece5c9f32734f"
          },
          "controlUi": {
            "allowedOrigins": [
              "http://localhost:18789",
              "http://127.0.0.1:18789"
            ]
          }
        }
      }

# Local Variables:
# mode: yaml
# End:
